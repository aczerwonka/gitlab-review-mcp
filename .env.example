# GitLab Review MCP Server - Environment Configuration
#
# Copy this file to .env and fill in your values
# or export these variables in your shell

# GitLab instance URL (without trailing slash)
# Example: https://gitlab.com or https://gitlab.yourcompany.com
GITLAB_BASE_URL=https://gitlab.example.com

# GitLab Personal Access Token
# Get it from: User Settings > Access Tokens
# Required scopes: api, read_api, write_repository
GITLAB_TOKEN=glpat-your-token-here

